# Copie este arquivo para ".env.local" (localmente) e configure as MESMAS
# variáveis no painel do Vercel em Settings > Environment Variables.
#
# Onde encontrar os valores: no painel do Supabase, vá em
# Project Settings > API. "Project URL" é a primeira, "anon public" é a
# chave publica (é seguro expor essa chave no navegador — o acesso real é
# controlado pelas politicas de RLS no banco, ver supabase/schema.sql).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
