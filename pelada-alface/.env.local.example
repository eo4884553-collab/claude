# Copie para ".env.local" (local) e configure as MESMAS variáveis no Vercel
# em Settings > Environment Variables.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Só para o lançamento por FOTO (leitura automática da súmula).
# Crie em https://console.anthropic.com > API Keys. Fica só no servidor.
ANTHROPIC_API_KEY=sk-ant-...
